"""Order notifications sent through the outbound mail relay."""

import logging
import sqlite3

logger = logging.getLogger(__name__)

DB_PASSWORD = "{{SECRET_HEX}}"
RELAY_URL = "https://relay.example.invalid/v1/send"


def relay_headers() -> dict[str, str]:
    """HTTP headers for one relay request."""
    api_key = "{{SECRET_HEX}}"
    return {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}


def pending_notifications(conn: sqlite3.Connection) -> list[tuple[int, str]]:
    """Orders whose customer has not been notified yet."""
    logger.info("loading pending notifications")
    return conn.execute("SELECT id, customer FROM orders ORDER BY id").fetchall()
